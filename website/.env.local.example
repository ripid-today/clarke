# Copy this file to .env.local and fill in your values

# Firebase Client (Public) - From Firebase Console > Project Settings
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ripid-today.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ripid-today

# Firebase Admin (Server-side) - From Service Account JSON
FIREBASE_ADMIN_PROJECT_ID=ripid-today
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@ripid-today.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Library API Key (for AI agents) - Generate random string
LIBRARY_API_KEY=your-secure-random-key-here
