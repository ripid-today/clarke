{
  "name": "extract-doc-skill",
  "version": "1.0.0",
  "description": "Extract text and metadata from documents using liteparse",
  "private": true,
  "type": "module",
  "bin": {
    "extract-doc": "./src/index.ts"
  },
  "scripts": {
    "extract": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@llamaindex/liteparse": "^1.3.1",
    "commander": "^12.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
